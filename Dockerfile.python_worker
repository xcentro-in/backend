# -- Build stage (install deps in a venv) ------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

COPY python_worker/requirements.txt .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt


# -- Runtime stage -----------------------------------------------------------
FROM python:3.12-slim

# System deps required by invoice2data (PDF parsing + OCR)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (matches Go worker pattern)
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -m appuser

WORKDIR /app

# Copy virtual-env from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY python_worker/ .

# Copy invoice2data templates into the image
COPY python_worker/templates/ /app/templates/

# Temp directory for downloaded files
RUN mkdir -p /tmp/extraction && chown appuser:appuser /tmp/extraction

# Ownership
RUN chown -R appuser:appuser /app

USER appuser

ENTRYPOINT ["python", "main.py"]
