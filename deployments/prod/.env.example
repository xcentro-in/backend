# =============================================================================
# Xcentro Backend Environment Configuration - PRODUCTION
# =============================================================================
# Copy this file to .env and update the values according to your setup
# Note: .env files should never be committed to version control
#
# IMPORTANT FOR PRODUCTION:
# - DB_HOST should be "postgres" (Docker Compose service name)
# - REDIS_HOST should be "redis" (Docker Compose service name)
# - DB_MIGRATION_USER should be "xcentro_owner" (created automatically)
# - Use strong passwords for all credentials!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Public-facing backend URL (used for callbacks from external services)
# Development: http://localhost:8888
# Production: https://api.yourdomain.com
SERVER_URL=http://localhost:8888

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend application URL (used for email links, password reset, etc.)
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main database connection (used by the application)
# Production: Use service name from docker-compose
DB_HOST=postgres
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_app
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

# Migration database user (separate user for running migrations)
# Uses same DB_HOST, DB_PORT, DB_NAME, DB_SCHEMA, DB_SSL_MODE as above
DB_MIGRATION_USER=xcentro_owner
DB_MIGRATION_PASSWORD=your_secure_migration_password_here

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
# Development (local): localhost
# Production (Docker Compose): redis (service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a strong secret key for JWT tokens (minimum 32 characters recommended)
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_here_minimum_32_chars

# =============================================================================
# BCRYPT CONFIGURATION
# =============================================================================
# Bcrypt cost (number of rounds) for password hashing
# Range: 4-31, Default: 12 (higher = more secure but slower)
BCRYPT_COST=12

# Bcrypt pepper (additional secret mixed with passwords before hashing)
# Generate using: openssl rand -base64 32
BCRYPT_PEPPER=your_bcrypt_pepper_secret_here_minimum_32_chars

# =============================================================================
# BANK ACCOUNT ENCRYPTION CONFIGURATION
# =============================================================================
# AES-256-GCM encryption key for bank account numbers (PCI DSS compliance)
# Generate a strong 32-byte key using: openssl rand -base64 32
# This key is used to encrypt/decrypt account_number_encrypted field
BANK_ACCOUNT_ENCRYPTION_KEY=your_32_byte_encryption_key_here_changeme

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for cross-origin requests
# Development: http://localhost:8080,http://localhost:3000
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
S3_BUCKET=test
S3_REGION=ap-south-1
S3_ACCESS_KEY=akey
S3_SECRET_KEY=skey

# =============================================================================
# AWS SES CONFIGURATION
# =============================================================================
SES_DEFAULT_FROM_EMAIL=test
SES_DEFAULT_FROM_NAME=Xcentro
SES_REGION=ap-south-1
SES_ACCESS_KEY=akey
SES_SECRET_KEY=skey

# Notification emails from address (for notification system)
SES_NOTIFICATION_FROM_EMAIL=noreply@transactions.xcentro.in
SES_NOTIFICATION_FROM_NAME=Xcentro Notifications

# =============================================================================
# CASTLER PAYOUT PROVIDER CONFIGURATION
# =============================================================================
# Castler API endpoint (default: https://api.castler.in)
CASTLER_BASE_URL=https://api.castler.in

# Castler API credentials (provided by Castler team)
# NOTE: These are placeholder values until real credentials are provided
CASTLER_API_KEY=dummy_castler_api_key_placeholder
CASTLER_SECRET_KEY=dummy_castler_secret_key_placeholder

# Webhook signature verification secret (provided by Castler team)
CASTLER_WEBHOOK_SECRET=dummy_webhook_secret_placeholder

# AES-256 Encryption Configuration (Required for encrypted API communication)
# Encryption key: Your secret key for AES-256 encryption (will be hashed to 32 bytes)
CASTLER_ENCRYPTION_KEY=OQ55PNSCLT0JKBXTL4XS7E0G4JPQC3NL

# Fixed IV for AES-256-CBC encryption (base64 encoded, 16 bytes)
# Default IV string: "NC0V0$0T0L030RME" (as specified by Castler)
# Base64 encoded value: TkMwVjAkMFQwTDAzMFJNRQ==
CASTLER_ENCRYPTION_IV=TkMwVjAkMFQwTDAzMFJNRQ==

# =============================================================================
# DB and redis users
# PostgreSQL Configuration
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=SuperSecure123!
POSTGRES_DB=xcentro
POSTGRES_PORT=5432

# Application Database Users (for post-deployment setup)
DB_OWNER_USER=xcentro_owner
DB_OWNER_PASSWORD=OwnerSecure456!
DB_RW_USER=xcentro_rw
DB_RW_PASSWORD=RwSecure101!

# Redis Configuration
REDIS_PORT=6379
REDIS_SUPERUSER=redis_super
REDIS_SUPERUSER_PASSWORD=RedisSuper123!
REDIS_APP_USER=xcentro_redis
REDIS_APP_PASSWORD=XcentroRedis456!
