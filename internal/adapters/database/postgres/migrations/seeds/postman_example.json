  "item": [
    {
      "name": "Get Payment Sources With Fees",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text",
            "description": "Replace {{jwt_token}} with your actual JWT token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"business_id\": \"01936d7a-7c8e-7890-b123-456789abcdef\",\n  \"payment_context\": \"vendor_payment\",\n  \"base_amount\": 100000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/v1/process_payment/get_payment_sources_with_fees",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "process_payment",
            "get_payment_sources_with_fees"
          ]
        },
        "description": "Retrieves all payment sources (cards and bank accounts) with calculated fees based on payment context and amount.\n\n**Test Business ID:** 01936d7a-7c8e-7890-b123-456789abcdef\n\n**Expected Result:**\n- 4 active stored cards (Visa, Mastercard, RuPay, Amex)\n- 3 verified bank accounts (HDFC, ICICI, SBI)\n- Fee calculations based on payment context"
      },
      "response": []
    },
