# =============================================================================
# Local Development Secrets (.env.local)
# =============================================================================
# This file contains sensitive values for LOCAL DEVELOPMENT ONLY
#
# Setup Instructions:
# 1. Copy this file to .env.local (gitignored)
# 2. Fill in your local development secrets below
# 3. Set SECRETS_USE_FALLBACK=true in your .env file
#
# IMPORTANT:
# - .env.local is gitignored and should NEVER be committed
# - In production, these values come from AWS Secrets Manager
# - Only use this for local development on your machine

# =============================================================================
# NOTE: With mock modes enabled in .env, most credentials below are NOT used
# =============================================================================
# If you have MOCKPG_ENABLED=true, CASTLER_MOCK_ENABLED=true, and
# AUTHBRIDGE_USE_MOCK=true in your .env file (which is the default for dev),
# the following credentials are NOT required for local development:
#   - Payment gateway credentials (JioPay, Easebuzz)
#   - Castler payout provider credentials
#   - AuthBridge/TruthScreen credentials
#
# You can use the dummy values provided below or leave them as placeholders.
# Only fill in real credentials if you need to test against actual services.

# =============================================================================
# ENABLE FALLBACK MODE FOR LOCAL DEVELOPMENT
# =============================================================================
SECRETS_USE_FALLBACK=true

# =============================================================================
# ENCRYPTION KEYS & AUTHENTICATION SECRETS
# =============================================================================
# JWT secret key (generate using: openssl rand -base64 32)
JWT_SECRET_KEY=local_dev_jwt_secret_key_change_me_minimum_32_characters

# Bcrypt pepper (generate using: openssl rand -base64 32)
BCRYPT_PEPPER=local_dev_bcrypt_pepper_change_me_minimum_32_characters

# Bank account encryption key (generate using: openssl rand -base64 32)
BANK_ACCOUNT_ENCRYPTION_KEY=local_dev_bank_encryption_key_32_bytes_changeme

# Ops token encryption key (generate using: openssl rand -base64 32)
OPS_TOKEN_ENCRYPTION_KEY=local_dev_ops_token_encryption_key_32_bytes

# Rate limiter HMAC secret (generate using: openssl rand -base64 32)
RATE_LIMITER_HMAC_SECRET=local_dev_rate_limiter_hmac_secret_changeme

# =============================================================================
# DATABASE & CACHE PASSWORDS
# =============================================================================
# Match these with deployments/docker/.env for local Docker setup
# Default passwords from Docker setup (change if you customized them)
DB_PASSWORD=RwSecure101!
DB_MIGRATION_PASSWORD=OwnerSecure456!
REDIS_PASSWORD=XcentroRedis456!

# =============================================================================
# AWS CREDENTIALS (for local S3/SES testing)
# =============================================================================
# Use your personal AWS dev account credentials or localstack
# NOTE: Only needed if testing file uploads (S3) or email sending (SES)
# Can use dummy values if not testing these features
S3_ACCESS_KEY=your_local_s3_access_key
S3_SECRET_KEY=your_local_s3_secret_key
SES_ACCESS_KEY=your_local_ses_access_key
SES_SECRET_KEY=your_local_ses_secret_key

# =============================================================================
# JIOPAY CREDENTIALS (UAT/Test environment)
# =============================================================================
# NOTE: Only needed if MOCKPG_ENABLED=false in .env (disabled mock mode)
# With mock mode enabled (default), these are NOT used
JIOPAY_API_KEY=your_jiopay_uat_api_key
JIOPAY_APP_ID=your_jiopay_uat_app_id
JIOPAY_ENCRYPTION_KEY=your_16byte_key!!
JIOPAY_WEBHOOK_SECRET=your_jiopay_uat_webhook_secret

# =============================================================================
# EASEBUZZ CREDENTIALS (Test environment)
# =============================================================================
# NOTE: Only needed if MOCKPG_ENABLED=false in .env (disabled mock mode)
# With mock mode enabled (default), these are NOT used
EASEBUZZ_MERCHANT_KEY=your_easebuzz_test_merchant_key
EASEBUZZ_SALT=your_easebuzz_test_salt
EASEBUZZ_API_KEY=your_easebuzz_test_api_key
EASEBUZZ_MERCHANT_TOKEN_ID=your_easebuzz_test_token_id
EASEBUZZ_ENCRYPTION_KEY=your_easebuzz_encryption_key
EASEBUZZ_ENCRYPTION_IV=your_easebuzz_encryption_iv
EASEBUZZ_WEBHOOK_SECRET=your_easebuzz_test_webhook_secret

# =============================================================================
# CASTLER CREDENTIALS (or use mock mode)
# =============================================================================
# NOTE: Only needed if CASTLER_MOCK_ENABLED=false in .env (disabled mock mode)
# With mock mode enabled (default), these dummy values are sufficient
CASTLER_API_KEY=dummy_castler_api_key_or_use_mock
CASTLER_SECRET_KEY=dummy_castler_secret_key_or_use_mock
CASTLER_WEBHOOK_SECRET=dummy_webhook_secret
CASTLER_ENCRYPTION_KEY=OQ55PNSCLT0JKBXTL4XS7E0G4JPQC3NL
CASTLER_ENCRYPTION_IV=TkMwVjAkMFQwTDAzMFJNRQ==
CASTLER_ESCROW_ID=your_escrow_id

# =============================================================================
# OPS DASHBOARD OAUTH
# =============================================================================
OPS_OAUTH_CLIENT_SECRET=your_office365_client_secret_for_local_testing

# =============================================================================
# CLOUDFLARE TURNSTILE (leave empty to disable for local dev)
# =============================================================================
TURNSTILE_SECRET_KEY=

# =============================================================================
# AUTHBRIDGE/TRUTHSCREEN (KYC/KYB Verification)
# =============================================================================
# NOTE: Only needed if AUTHBRIDGE_USE_MOCK=false in .env (disabled mock mode)
# With mock mode enabled (default), this is NOT used
TRUTHSCREEN_PASSWORD=your_truthscreen_password_here

# =============================================================================
# SMS SERVICE (Fast2SMS)
# =============================================================================
FAST2SMS_API_KEY=your_fast2sms_api_key_here
