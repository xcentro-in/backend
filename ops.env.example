# =============================================================================
# Xcentro Ops Dashboard Environment Configuration
# =============================================================================
# This file contains environment variables specific to the Ops Dashboard server.
# It shares most configuration with the main API but has different:
#   - SERVER_PORT (8889 instead of 8888)
#   - FRONTEND_URL (ops dashboard frontend instead of main app frontend)
#   - CORS_ALLOW_ORIGINS (ops dashboard frontend URL)
#
# For local development: Copy values from .env and adjust as needed.
# For production: Deploy with appropriate ops-specific values.

# =============================================================================
# AWS SECRETS MANAGER CONFIGURATION (Production)
# =============================================================================
AWS_REGION=ap-south-1
AWS_SECRET_NAME=
SECRETS_USE_FALLBACK=true

# =============================================================================
# ENVIRONMENT & LOGGING CONFIGURATION
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=text

# =============================================================================
# SERVER CONFIGURATION (OPS-SPECIFIC)
# =============================================================================
SERVER_HOST=0.0.0.0
# OPS Dashboard runs on port 8889 (different from main API's 8888)
SERVER_PORT=8889
# Public-facing ops backend URL
# Development: http://localhost:8889
# Production: https://ops-api.yourdomain.com
SERVER_URL=http://localhost:8889

# =============================================================================
# FRONTEND CONFIGURATION (OPS-SPECIFIC)
# =============================================================================
# Ops Dashboard Frontend URL
# Development: http://localhost:8081 (ops dashboard frontend → connects to ops backend :8889)
# Production: https://ops.yourdomain.com
FRONTEND_URL=http://localhost:8081

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_rw
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

DB_MIGRATION_USER=xcentro_owner

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h
JWT_MAX_WEB_SESSIONS=3
JWT_MAX_MOBILE_SESSIONS=5

# =============================================================================
# BCRYPT CONFIGURATION
# =============================================================================
BCRYPT_COST=12

# =============================================================================
# COOKIE & CORS CONFIGURATION (OPS-SPECIFIC)
# =============================================================================
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN is auto-extracted from FRONTEND_URL (ops.xcentro.in)
COOKIE_DOMAIN=

# CORS: Comma-separated list of allowed origins
# Development: http://localhost:8081 (ops dashboard frontend only)
# Production: https://ops.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:8081
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
S3_BUCKET=xcentro-production
S3_REGION=ap-south-1

# =============================================================================
# AWS SES CONFIGURATION
# =============================================================================
SES_DEFAULT_FROM_EMAIL=noreply@xcentro.in
SES_DEFAULT_FROM_NAME=Xcentro
SES_REGION=ap-south-1
SES_NOTIFICATION_FROM_EMAIL=noreply@transactions.xcentro.in
SES_NOTIFICATION_FROM_NAME=Xcentro Notifications

# =============================================================================
# OPS DASHBOARD ACCESS CONTROL
# =============================================================================
# false = Allow ops dashboard requests (REQUIRED for ops server)
OPS_REJECT_ACCESS=false

# =============================================================================
# OPS DASHBOARD OAUTH2/OIDC CONFIGURATION
# =============================================================================
OPS_OAUTH_CLIENT_ID=your_office365_client_id
# Redirect URL must match ops backend server port (8889)
OPS_OAUTH_REDIRECT_URL=http://localhost:8889/ops/v1/auth/callback
OPS_OAUTH_TENANT_ID=organizations

# Skip OAuth validation (DEV/TESTING ONLY)
# true = Bypass JWT validation (allows unauthenticated access) - RECOMMENDED FOR DEV
# false = Enforce JWT validation (required for production)
OPS_OAUTH_SKIP_VALIDATION=true

# =============================================================================
# CLOUDFLARE TURNSTILE CONFIGURATION
# =============================================================================
TURNSTILE_ENABLED=false

# =============================================================================
# AUTHBRIDGE CONFIGURATION
# =============================================================================
TRUTHSCREEN_USERNAME=test@paysphere.co.in
AUTHBRIDGE_USE_MOCK=true

# =============================================================================
# CASTLER & PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Ops dashboard may need these for viewing payment/payout data
CASTLER_BASE_URL=https://api.castler.in
CASTLER_MOCK_ENABLED=true

JIOPAY_BASE_URL=https://uat.jiopay.co.in/pg/api/v2
JIOPAY_TOKENIZATION_BASE_URL=https://uat.jiopay.co.in/qatsp/api/vault
JIOPAY_MERCHANT_ID=your_merchant_id
JIOPAY_IS_AGGREGATOR_MODEL=false

EASEBUZZ_BASE_URL=https://pay.easebuzz.in
EASEBUZZ_IS_AGGREGATOR_MODEL=false

MOCKPG_ENABLED=true
MOCKPG_MERCHANT_ID=MOCK_MERCHANT_123
MOCKPG_API_KEY=mock_api_key_for_testing_only
MOCKPG_SIMULATE_SUCCESS=true
MOCKPG_IS_AGGREGATOR_MODEL=false

# =============================================================================
# AUTO PAYOUT CONFIGURATIONS
# =============================================================================
AUTO_PAYOUT_WORKER_ENABLED=false
AUTO_PAYOUT_POLL_INTERVAL_MINUTES=60
AUTO_PAYOUT_BATCH_SIZE=2

# =============================================================================
# PAYEE VALIDATION CONFIGURATION
# =============================================================================
PAYEE_STRICT_VALIDATION_ENABLED=false
