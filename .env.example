# =============================================================================
# Xcentro Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# Note: .env files should never be committed to version control
#
# IMPORTANT: Sensitive values (passwords, encryption keys, API keys) are stored
# in AWS Secrets Manager for production. For local development, create a .env.local
# file (gitignored) and set SECRETS_USE_FALLBACK=true to use local secrets.

# =============================================================================
# AWS SECRETS MANAGER CONFIGURATION (Production)
# =============================================================================
# AWS region for Secrets Manager
AWS_REGION=ap-south-1

# AWS Secrets Manager secret name containing all backend secrets
# Format: xcentro/backend/{environment}
# Production: xcentro/backend/production
# Staging: xcentro/backend/staging
# Development: Leave empty to use .env.local secrets
AWS_SECRET_NAME=

# Enable fallback to environment variables (for local development only)
# true = If AWS Secrets Manager fails or AWS_SECRET_NAME is empty, use .env.local
# false = Fail startup if AWS Secrets Manager is unavailable (recommended for production)
SECRETS_USE_FALLBACK=true

# Optional: Static AWS credentials (for local development only)
# In production, use IAM roles attached to EC2/ECS instances (no credentials needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# ENVIRONMENT & LOGGING CONFIGURATION
# =============================================================================
# Environment mode: development, staging, production
# Affects default log level and security settings
ENVIRONMENT=development

# Logger configuration
# LOG_LEVEL: debug, info, warn, error (default: info for production, debug for dev)
# LOG_FORMAT: text, json (default: text, use json for log aggregation in production)
LOG_LEVEL=debug
LOG_FORMAT=text

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8888
# Public-facing backend URL (used for callbacks from external services)
# Development: http://localhost:8888 (main backend), http://localhost:8889 (ops backend)
# Production: https://api.yourdomain.com
SERVER_URL=http://localhost:8888

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend application URL (used for email links, password reset, OAuth redirects)
# Development:
#   - http://localhost:8080 (main app frontend → connects to backend :8888)
#   - http://localhost:8081 (ops dashboard frontend → connects to ops backend :8889)
# Production: https://app.yourdomain.com or https://ops.yourdomain.com
FRONTEND_URL=http://localhost:8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main database connection (used by the application)
# Development (local): localhost
# Production (Docker Compose): postgres (service name)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_rw
# DB_PASSWORD is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

# Migration database user (separate user for running migrations)
# Uses same DB_HOST, DB_PORT, DB_NAME, DB_SCHEMA, DB_SSL_MODE as above
DB_MIGRATION_USER=xcentro_owner
# DB_MIGRATION_PASSWORD is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
# Development (local): localhost
# Production (Docker Compose): redis (service name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
# REDIS_PASSWORD is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT_SECRET_KEY is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# Generate using: openssl rand -base64 32

# Token expiry durations (supports Go duration format: h=hours, m=minutes)
# Access token expiry (short-lived, used for API authentication)
JWT_ACCESS_TOKEN_EXPIRY=1h

# Refresh token expiry (long-lived, used to get new access tokens)
# Default: 720h (30 days)
# For ops dashboard: This controls how long users stay logged in before requiring re-login
JWT_REFRESH_TOKEN_EXPIRY=720h

# Maximum concurrent sessions per device type
# When limit is reached, oldest session for that device is invalidated
JWT_MAX_WEB_SESSIONS=3
JWT_MAX_MOBILE_SESSIONS=5

# Verification token expiry durations
AUTH_EMAIL_VERIFICATION_EXPIRY=24h
AUTH_PASSWORD_RESET_EXPIRY=1h
AUTH_INVITATION_EXPIRY=1h

# =============================================================================
# BCRYPT CONFIGURATION
# =============================================================================
# Bcrypt cost (number of rounds) for password hashing
# Range: 4-31, Default: 12 (higher = more secure but slower)
BCRYPT_COST=12

# BCRYPT_PEPPER is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# Generate using: openssl rand -base64 32

# =============================================================================
# BANK ACCOUNT ENCRYPTION CONFIGURATION
# =============================================================================
# BANK_ACCOUNT_ENCRYPTION_KEY is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# Generate using: openssl rand -base64 32
# This key is used to encrypt/decrypt account_number_encrypted field (PCI DSS compliance)

# =============================================================================
# COOKIE & CORS CONFIGURATION
# =============================================================================
# Cookie configuration for authentication tokens
# COOKIE_SECURE: Set to true in production (requires HTTPS)
# COOKIE_SAMESITE: Strict (blocks all cross-site), Lax (allows top-level navigation), None (requires Secure=true)
# COOKIE_DOMAIN: Leave empty - CSRF cookie domain is auto-extracted from FRONTEND_URL
#   - For API: Uses domain from FRONTEND_URL (e.g., app.xcentro.in from https://app.xcentro.in)
#   - For OPS: Uses domain from FRONTEND_URL (e.g., ops.xcentro.in from https://ops.xcentro.in)
#   - This ensures CSRF tokens are only readable by the configured frontend
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# CORS: Comma-separated list of allowed origins for cross-origin requests
# Development: Include both main app and ops dashboard frontends
#   - http://localhost:8080 (main app frontend)
#   - http://localhost:8081 (ops dashboard frontend)
# Production: https://yourdomain.com,https://app.yourdomain.com,https://ops.yourdomain.com
# NOTE: Must include FRONTEND_URL for cookie-based auth to work
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
S3_BUCKET=xcentro-production
S3_REGION=ap-south-1
# S3_ACCESS_KEY and S3_SECRET_KEY are stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# In production with IAM roles: Leave empty, IAM role provides automatic credentials

# =============================================================================
# AWS SES CONFIGURATION
# =============================================================================
SES_DEFAULT_FROM_EMAIL=noreply@xcentro.in
SES_DEFAULT_FROM_NAME=Xcentro
SES_REGION=ap-south-1
# SES_ACCESS_KEY and SES_SECRET_KEY are stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# In production with IAM roles: Leave empty, IAM role provides automatic credentials

# Notification emails from address (for notification system)
SES_NOTIFICATION_FROM_EMAIL=noreply@transactions.xcentro.in
SES_NOTIFICATION_FROM_NAME=Xcentro Notifications

# =============================================================================
# SMS / OTP CONFIGURATION (Fast2SMS)
# =============================================================================
FAST2SMS_SENDER_ID=XCNTRO
FAST2SMS_ENDPOINT=https://www.fast2sms.com/dev/bulkV2
# FAST2SMS_API_KEY is stored in AWS Secrets Manager (production)
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRY=10m

# =============================================================================
# CASTLER PAYOUT PROVIDER CONFIGURATION
# =============================================================================
# Castler API endpoint (default: https://api.castler.in)
CASTLER_BASE_URL=https://api.castler.in

# Castler secrets stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# - CASTLER_API_KEY
# - CASTLER_SECRET_KEY
# - CASTLER_WEBHOOK_SECRET
# - CASTLER_ENCRYPTION_KEY (AES-256 encryption for API communication)
# - CASTLER_ENCRYPTION_IV (Fixed IV, base64 encoded 16 bytes)
# - CASTLER_ESCROW_ID (Escrow account ID for payout transfers)

# Mock Mode (Enable for development/testing without real API calls)
# Set to true to use mock Castler client (no real API calls) - RECOMMENDED FOR DEV
# Set to false to use real Castler API (requires valid credentials above)
CASTLER_MOCK_ENABLED=true

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# JioPay Payment Gateway
# -----------------------------------------------------------------------------
# JioPay API endpoints
JIOPAY_BASE_URL=https://uat.jiopay.co.in/pg/api/v2
JIOPAY_TOKENIZATION_BASE_URL=https://uat.jiopay.co.in/qatsp/api/vault

# JioPay merchant credentials (PUBLIC - not sensitive)
JIOPAY_MERCHANT_ID=your_merchant_id

# JioPay secrets stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# - JIOPAY_API_KEY (HMAC SHA256 key)
# - JIOPAY_APP_ID (vault APIs)
# - JIOPAY_ENCRYPTION_KEY (must be exactly 16 bytes for AES-128)
# - JIOPAY_WEBHOOK_SECRET

# JioPay payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
JIOPAY_IS_AGGREGATOR_MODEL=false

# -----------------------------------------------------------------------------
# Easebuzz Payment Gateway
# -----------------------------------------------------------------------------
# Easebuzz API endpoint
EASEBUZZ_BASE_URL=https://pay.easebuzz.in

# Easebuzz secrets stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# - EASEBUZZ_MERCHANT_KEY
# - EASEBUZZ_SALT
# - EASEBUZZ_API_KEY (for TMS APIs)
# - EASEBUZZ_MERCHANT_TOKEN_ID
# - EASEBUZZ_ENCRYPTION_KEY (optional)
# - EASEBUZZ_ENCRYPTION_IV (optional)
# - EASEBUZZ_WEBHOOK_SECRET

# Easebuzz payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
EASEBUZZ_IS_AGGREGATOR_MODEL=false

# -----------------------------------------------------------------------------
# Mock Payment Gateway (Testing Only)
# -----------------------------------------------------------------------------
# Enable mock PG to bypass real payment gateways for testing - RECOMMENDED FOR DEV
# When enabled, all payment requests will use the mock gateway regardless of routing rules
# This allows end-to-end testing without making real API calls or incurring charges
MOCKPG_ENABLED=true

# Mock merchant credentials (for testing purposes)
MOCKPG_MERCHANT_ID=MOCK_MERCHANT_123
MOCKPG_API_KEY=mock_api_key_for_testing_only

# Simulate success/failure scenarios
# true = All operations succeed (useful for happy path testing)
# false = Randomly simulate failures (useful for error handling testing)
MOCKPG_SIMULATE_SUCCESS=true

# Mock PG payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
MOCKPG_IS_AGGREGATOR_MODEL=false

# =============================================================================
# OPS DASHBOARD ACCESS CONTROL
# =============================================================================
# Controls access to /ops/v1 endpoints
# true = Reject all ops dashboard requests (for production security)
# false = Allow ops dashboard requests (RECOMMENDED FOR DEV)
OPS_REJECT_ACCESS=false

# =============================================================================
# AUTO PAYOUT CONFIGURATIONS
# =============================================================================
AUTO_PAYOUT_WORKER_ENABLED=false
AUTO_PAYOUT_POLL_INTERVAL_MINUTES=60
AUTO_PAYOUT_BATCH_SIZE=2

# =============================================================================
# PAYEE ONBOARDING VALIDATION CONFIGURATION
# =============================================================================
# Enable strict validation checks during payee onboarding (vendor/employee)
# true = Enforce all anti-fraud checks (production mode):
#        - Money rotation checks
#        - Account holder name similarity validation (70% threshold)
#        - GSTIN name matching for vendors
# false = Skip strict validation checks (development/testing mode) - RECOMMENDED FOR DEV:
#        - Allows easier testing with mock data
#        - Bypasses name matching and fraud checks
# Production: MUST be true (always enforce in production)
# Development: Set to false for easier local testing
PAYEE_STRICT_VALIDATION_ENABLED=false

# =============================================================================
# OPS DASHBOARD OAUTH2/OIDC CONFIGURATION
# =============================================================================
# Office365 / Microsoft Entra ID OAuth2 configuration (PUBLIC - not sensitive)
# Redirect URL must match the ops backend server port (8889)
OPS_OAUTH_CLIENT_ID=your_office365_client_id
OPS_OAUTH_REDIRECT_URL=http://localhost:8889/ops/v1/auth/callback
OPS_OAUTH_TENANT_ID=organizations

# OPS_OAUTH_CLIENT_SECRET is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true

# Skip OAuth validation (DEV/TESTING ONLY - NEVER enable in production)
# true = Bypass JWT validation in middleware (allows unauthenticated access) - RECOMMENDED FOR DEV
# false = Enforce JWT validation (required for production)
# With this enabled, you can test ops endpoints directly without OAuth2 setup
OPS_OAUTH_SKIP_VALIDATION=true

# OPS_TOKEN_ENCRYPTION_KEY is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# Generate using: openssl rand -base64 32

# =============================================================================
# CLOUDFLARE TURNSTILE CONFIGURATION (Bot Protection)
# =============================================================================
# TURNSTILE_SECRET_KEY is stored in AWS Secrets Manager (production)
# For local development: Set in .env.local with SECRETS_USE_FALLBACK=true
# Or leave empty to disable bot protection for local development

# Enable/disable Turnstile verification
# true = Verify Turnstile tokens (requires TURNSTILE_SECRET_KEY)
# false = Skip Turnstile verification (all requests allowed)
# Default: false (disabled for local development)
TURNSTILE_ENABLED=false

# =============================================================================
# AUTHBRIDGE CONFIGURATION
# =============================================================================
# truthscreen secret stored in Secrets manager
# set in .env.local as TRUTHSCREEN_PASSWORD="<password>" for moving ahead
# much advised to set AUTHBRIDGE_USE_MOCK to True for ease of development
TRUTHSCREEN_USERNAME=test@paysphere.co.in
AUTHBRIDGE_USE_MOCK=true