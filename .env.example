# =============================================================================
# Xcentro Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# Note: .env files should never be committed to version control

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main database connection (used by the application)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_app
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

# Migration database user (separate user for running migrations)
# Uses same DB_HOST, DB_PORT, DB_NAME, DB_SCHEMA, DB_SSL_MODE as above
DB_MIGRATION_USER=xcentro_migration
DB_MIGRATION_PASSWORD=your_secure_migration_password_here

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a strong secret key for JWT tokens (minimum 32 characters recommended)
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_here_minimum_32_chars

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
S3_BUCKET=test
S3_REGION=ap-south-1
S3_ACCESS_KEY=akey
S3_SECRET_KEY=skey

# =============================================================================
# AWS SES CONFIGURATION
# =============================================================================
SES_DEFAULT_FROM_EMAIL=test
SES_DEFAULT_FROM_NAME=Xcentro
SES_REGION=ap-south-1
SES_ACCESS_KEY=akey
SES_SECRET_KEY=skey

# =============================================================================
# CASTLER PAYOUT PROVIDER CONFIGURATION
# =============================================================================
# Castler API endpoint (default: https://api.castler.in)
CASTLER_BASE_URL=https://api.castler.in

# Castler API credentials (provided by Castler team)
# NOTE: These are placeholder values until real credentials are provided
CASTLER_API_KEY=dummy_castler_api_key_placeholder
CASTLER_SECRET_KEY=dummy_castler_secret_key_placeholder

# Webhook signature verification secret (provided by Castler team)
CASTLER_WEBHOOK_SECRET=dummy_webhook_secret_placeholder