# =============================================================================
# Xcentro Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# Note: .env files should never be committed to version control

# =============================================================================
# ENVIRONMENT & LOGGING CONFIGURATION
# =============================================================================
# Environment mode: development, staging, production
# Affects default log level and security settings
ENVIRONMENT=development

# Logger configuration
# LOG_LEVEL: debug, info, warn, error (default: info for production, debug for dev)
# LOG_FORMAT: text, json (default: text, use json for log aggregation in production)
LOG_LEVEL=debug
LOG_FORMAT=text

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Public-facing backend URL (used for callbacks from external services)
# Development: http://localhost:8888
# Production: https://api.yourdomain.com
SERVER_URL=http://localhost:8888

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend application URL (used for email links, password reset, etc.)
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main database connection (used by the application)
# Development (local): localhost
# Production (Docker Compose): postgres (service name)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_app
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

# Migration database user (separate user for running migrations)
# Uses same DB_HOST, DB_PORT, DB_NAME, DB_SCHEMA, DB_SSL_MODE as above
DB_MIGRATION_USER=xcentro_migration
DB_MIGRATION_PASSWORD=your_secure_migration_password_here

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
# Development (local): localhost
# Production (Docker Compose): redis (service name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a strong secret key for JWT tokens (minimum 32 characters recommended)
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_here_minimum_32_chars

# =============================================================================
# BCRYPT CONFIGURATION
# =============================================================================
# Bcrypt cost (number of rounds) for password hashing
# Range: 4-31, Default: 12 (higher = more secure but slower)
BCRYPT_COST=12

# Bcrypt pepper (additional secret mixed with passwords before hashing)
# Generate using: openssl rand -base64 32
BCRYPT_PEPPER=your_bcrypt_pepper_secret_here_minimum_32_chars

# =============================================================================
# BANK ACCOUNT ENCRYPTION CONFIGURATION
# =============================================================================
# AES-256-GCM encryption key for bank account numbers (PCI DSS compliance)
# Generate a strong 32-byte key using: openssl rand -base64 32
# This key is used to encrypt/decrypt account_number_encrypted field
BANK_ACCOUNT_ENCRYPTION_KEY=your_32_byte_encryption_key_here_changeme

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for cross-origin requests
# Development: http://localhost:8080,http://localhost:3000
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
S3_BUCKET=test
S3_REGION=ap-south-1
S3_ACCESS_KEY=akey
S3_SECRET_KEY=skey

# =============================================================================
# AWS SES CONFIGURATION
# =============================================================================
SES_DEFAULT_FROM_EMAIL=test
SES_DEFAULT_FROM_NAME=Xcentro
SES_REGION=ap-south-1
SES_ACCESS_KEY=akey
SES_SECRET_KEY=skey

# Notification emails from address (for notification system)
SES_NOTIFICATION_FROM_EMAIL=noreply@transactions.xcentro.in
SES_NOTIFICATION_FROM_NAME=Xcentro Notifications

# =============================================================================
# JIOPAY PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# JioPay API base URLs
# Production: https://api.jiopay.com
# UAT: https://uat.jiopay.co.in
JIOPAY_BASE_URL=https://api.jiopay.com
JIOPAY_TOKENIZATION_BASE_URL=https://uat.jiopay.co.in/qatsp/api/vault

# JioPay merchant credentials (provided by JioPay team)
JIOPAY_MERCHANT_ID=your_jiopay_merchant_id
JIOPAY_API_KEY=your_jiopay_api_key
JIOPAY_APP_ID=your_jiopay_app_id

# AES-128 encryption key for x-app-token generation (16 bytes)
JIOPAY_ENCRYPTION_KEY=your_16_byte_encryption_key

# Webhook signature verification secret (provided by JioPay)
JIOPAY_WEBHOOK_SECRET=your_jiopay_webhook_secret

# =============================================================================
# EASEBUZZ PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Easebuzz API base URL
# Production: https://pay.easebuzz.in
# UAT: https://testpay.easebuzz.in
EASEBUZZ_BASE_URL=https://pay.easebuzz.in

# Easebuzz merchant credentials (provided by Easebuzz team)
EASEBUZZ_MERCHANT_KEY=your_easebuzz_merchant_key
EASEBUZZ_SALT=your_easebuzz_salt
EASEBUZZ_API_KEY=your_easebuzz_api_key

# AES encryption configuration (optional, for secure communication)
# EASEBUZZ_ENCRYPTION_KEY=your_easebuzz_encryption_key
# EASEBUZZ_ENCRYPTION_IV=your_easebuzz_encryption_iv_base64

# Webhook signature verification secret (provided by Easebuzz)
EASEBUZZ_WEBHOOK_SECRET=your_easebuzz_webhook_secret

# =============================================================================
# AWS CLOUDWATCH METRICS CONFIGURATION
# =============================================================================
# Enable/disable CloudWatch metrics collection (true/false)
# Set to true in production for monitoring payment processing and system health
CLOUDWATCH_ENABLED=false

# AWS region for CloudWatch (should match your deployment region)
CLOUDWATCH_REGION=ap-south-1

# CloudWatch namespace for grouping metrics (default: XCentro/Backend)
# All metrics will be organized under this namespace
CLOUDWATCH_NAMESPACE=XCentro/Backend

# Batch interval - how often to flush metrics to CloudWatch (default: 30s)
# Format: duration with unit (e.g., 30s, 1m, 2m)
CLOUDWATCH_BATCH_INTERVAL=30s

# Batch size - maximum number of metrics to buffer before flushing (default: 20)
# Larger batches reduce API calls but increase memory usage
CLOUDWATCH_BATCH_SIZE=20

# Maximum retry attempts for failed CloudWatch API calls (default: 5)
CLOUDWATCH_MAX_RETRIES=5

# Flush metrics on application shutdown (true/false, default: true)
# Ensures no metrics are lost during graceful shutdown
CLOUDWATCH_FLUSH_ON_SHUTDOWN=true

# AWS credentials for CloudWatch (optional if using IAM roles)
# Leave empty when running on EC2/ECS with IAM roles attached
# CLOUDWATCH_ACCESS_KEY=your_cloudwatch_access_key
# CLOUDWATCH_SECRET_KEY=your_cloudwatch_secret_key

# Cost Estimate: ~$15-20/month for ~50 unique metrics
# See /docs/METRICS_GUIDE.md for complete documentation

# =============================================================================
# CASTLER PAYOUT PROVIDER CONFIGURATION
# =============================================================================
# Castler API endpoint (default: https://api.castler.in)
CASTLER_BASE_URL=https://api.castler.in

# Castler API credentials (provided by Castler team)
# NOTE: These are placeholder values until real credentials are provided
CASTLER_API_KEY=dummy_castler_api_key_placeholder
CASTLER_SECRET_KEY=dummy_castler_secret_key_placeholder

# Webhook signature verification secret (provided by Castler team)
CASTLER_WEBHOOK_SECRET=dummy_webhook_secret_placeholder

# AES-256 Encryption Configuration (Required for encrypted API communication)
# Encryption key: Your secret key for AES-256 encryption (will be hashed to 32 bytes)
CASTLER_ENCRYPTION_KEY=OQ55PNSCLT0JKBXTL4XS7E0G4JPQC3NL

# Fixed IV for AES-256-CBC encryption (base64 encoded, 16 bytes)
# Default IV string: "NC0V0$0T0L030RME" (as specified by Castler)
# Base64 encoded value: TkMwVjAkMFQwTDAzMFJNRQ==
CASTLER_ENCRYPTION_IV=TkMwVjAkMFQwTDAzMFJNRQ==

# Escrow account ID (provided by Castler for payout transfers)
CASTLER_ESCROW_ID=your_escrow_id_here

# Mock Mode (Enable for development/testing without real API calls)
# Set to true to use mock Castler client (no real API calls)
# Set to false to use real Castler API (requires valid credentials above)
CASTLER_MOCK_ENABLED=false

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# JioPay Payment Gateway
# -----------------------------------------------------------------------------
# JioPay API endpoints
JIOPAY_BASE_URL=https://uat.jiopay.co.in/pg/api/v2
JIOPAY_TOKENIZATION_BASE_URL=https://uat.jiopay.co.in/qatsp/api/vault

# JioPay merchant credentials (provided by JioPay)
JIOPAY_MERCHANT_ID=your_merchant_id
JIOPAY_API_KEY=your_api_key_for_hmac_sha256
JIOPAY_APP_ID=your_app_id_for_vault_apis
JIOPAY_ENCRYPTION_KEY=your_16byte_key!!  # Must be exactly 16 bytes for AES-128
JIOPAY_WEBHOOK_SECRET=your_webhook_secret

# JioPay payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
JIOPAY_IS_AGGREGATOR_MODEL=false

# -----------------------------------------------------------------------------
# Easebuzz Payment Gateway
# -----------------------------------------------------------------------------
# Easebuzz API endpoint
EASEBUZZ_BASE_URL=https://pay.easebuzz.in

# Easebuzz merchant credentials (provided by Easebuzz)
EASEBUZZ_MERCHANT_KEY=your_merchant_key
EASEBUZZ_SALT=your_salt_key
EASEBUZZ_API_KEY=your_api_key_for_tms_apis
EASEBUZZ_MERCHANT_TOKEN_ID=your_merchant_token_id
EASEBUZZ_ENCRYPTION_KEY=your_encryption_key_optional
EASEBUZZ_ENCRYPTION_IV=your_encryption_iv_optional
EASEBUZZ_WEBHOOK_SECRET=your_webhook_secret

# Easebuzz payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
EASEBUZZ_IS_AGGREGATOR_MODEL=false

# -----------------------------------------------------------------------------
# Mock Payment Gateway (Testing Only)
# -----------------------------------------------------------------------------
# Enable mock PG to bypass real payment gateways for testing
# When enabled, all payment requests will use the mock gateway regardless of routing rules
# This allows end-to-end testing without making real API calls or incurring charges
MOCKPG_ENABLED=false

# Mock merchant credentials (for testing purposes)
MOCKPG_MERCHANT_ID=MOCK_MERCHANT_123
MOCKPG_API_KEY=mock_api_key_for_testing_only

# Simulate success/failure scenarios
# true = All operations succeed (useful for happy path testing)
# false = Randomly simulate failures (useful for error handling testing)
MOCKPG_SIMULATE_SUCCESS=true

# Mock PG payment model
# false = Normal model (merchant passes total amount including convenience fee to PG)
# true = Aggregator model (merchant passes base amount, PG charges convenience fee from customer)
MOCKPG_IS_AGGREGATOR_MODEL=false
# Mock Mode (Enable for development/testing without real API calls)
# Set to true to use mock Castler client (no real API calls)
# Set to false to use real Castler API (requires valid credentials above)
CASTLER_MOCK_ENABLED=false

# =============================================================================
# OPS DASHBOARD ACCESS CONTROL
# =============================================================================
# Controls access to /ops/v1 endpoints
# true = Reject all ops dashboard requests (default, for production security)
# false = Allow ops dashboard requests
OPS_REJECT_ACCESS=true

# =============================================================================
# AUTO PAYOUT CONFIGURATIONS
# =============================================================================
AUTO_PAYOUT_WORKER_ENABLED=false
AUTO_PAYOUT_POLL_INTERVAL_MINUTES=60
AUTO_PAYOUT_BATCH_SIZE=2