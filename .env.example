# =============================================================================
# Xcentro Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# Note: .env files should never be committed to version control

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main database connection (used by the application)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcentro
DB_USER=xcentro_app
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=xcentro
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_SSL_MODE=disable

# Migration database user (separate user for running migrations)
# Uses same DB_HOST, DB_PORT, DB_NAME, DB_SCHEMA, DB_SSL_MODE as above
DB_MIGRATION_USER=xcentro_migration
DB_MIGRATION_PASSWORD=your_secure_migration_password_here

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=xcentro_redis
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a strong secret key for JWT tokens (minimum 32 characters recommended)
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_here_minimum_32_chars

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. For local development, you can use the default PostgreSQL and Redis users
#    by setting DB_USER=postgres, DB_MIGRATION_USER=postgres, and REDIS_USERNAME="" (empty)
#    In this case, you can use the same password for both DB_PASSWORD and DB_MIGRATION_PASSWORD
# 
# 2. For production, create dedicated users with minimal required permissions:
#    - xcentro_app: Main application user with read/write access to application tables
#    - xcentro_migration: Migration user with schema modification permissions
#    - xcentro_redis: Redis user with appropriate access controls
#
# 3. The DB_MIGRATION_USER and DB_MIGRATION_PASSWORD are used only when running 
#    migrations via cmd/migrate, while DB_USER and DB_PASSWORD are used for 
#    normal application database operations
#
# 4. Make sure to use strong passwords and keep this file secure
#
# 5. Never commit the actual .env file to version control - only this .env.example