# Build stage
FROM golang:1.25.1-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o migrate ./cmd/migrate

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

# Copy binary
COPY --from=builder /build/migrate .

# Copy migrations directory with correct path structure
COPY --from=builder /build/internal/adapters/database/postgres/migrations/sql ./internal/adapters/database/postgres/migrations/sql

RUN chown -R appuser:appuser /app

USER appuser

# Default path matches the location in the image
ENTRYPOINT ["/app/migrate", "-action=up", "-path=internal/adapters/database/postgres/migrations/sql"]
