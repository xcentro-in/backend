// =============================================================================
// USER & IDENTITY TABLES
// =============================================================================

Table "user_identity" {
  "tax_id" text [pk, note: 'PAN or generic tax identifier']
  "tax_id_data" jsonb
  "national_id" text [unique, note: 'Aadhaar/SSN/National ID']
  "national_id_data" jsonb
  "n_txn_id" text
  "created_at" timestamptz
  "updated_at" timestamptz
  Note: 'Personal identity & compliance artifacts (externalized KYC data)'
}

Table "user_table" {
  "id" uuid [pk, default: `uuidv7()`]
  "name" text
  "dob" date
  "email" varchar(254) [unique, not null]
  "pwd_hash" text [not null]
  "mobile" varchar(20)
  "tax_id" text [ref: > user_identity.tax_id]
  "kyc_status" kyc_status_enum [not null, default: 'kyc_not_started']
  "kyc_needed" boolean [default: true]
  "email_verified" boolean [default: false]
  "mobile_verified" boolean [default: false]
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  Note: 'User accounts, authentication, and KYC data'
}

Table "user_verification_codes" {
  "id" uuid [pk, default: `uuidv7()`]
  "user_id" uuid [ref: > user_table.id, note: 'ON DELETE CASCADE']
  "code" text
  "code_type" verification_type
  "expires_at" timestamptz
  "created_at" timestamptz [default: `NOW()`]
  "used" boolean [default: false]
  "retry_attempts" integer [default: 0]
}

Table "user_tokens" {
  "session_id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null, ref: > user_table.id, note: 'ON DELETE CASCADE']
  "refresh_token_hash" text [not null]
  "expires_at" timestamptz [not null]
  "created_at" timestamptz [default: `NOW()`]
  "last_used_at" timestamptz [default: `NOW()`]
  "user_agent" text

  indexes {
    (user_id, refresh_token_hash) [name: 'idx_user_tokens_user_token']
    expires_at [name: 'idx_user_tokens_expires_at']
  }
  Note: 'JWT refresh token tracking'
}

// =============================================================================
// BUSINESS TABLES
// =============================================================================

Table "kyb_data" {
  "income_tax_id" text [pk]
  "income_tax_id_data" jsonb
  "company_id" text
  "company_id_data" jsonb
  "business_deed" text
  Note: 'Know Your Business (KYB) identity and corporate data'
}

Table "business" {
  "bid" uuid [pk, default: `uuidv7()`]
  "name" text
  "gstin" varchar(15) [unique]
  "gst_data" jsonb
  "income_tax_id" text [ref: > kyb_data.income_tax_id]
  "kyb_status" kyc_status_enum [default: 'kyc_not_started']
  "business_type" business_type_enum
  "business_model" text
  "business_turnover" text
  "country_code" varchar(3)
  "currency_code" varchar(3)
  "has_completed_onboarding" boolean [not null, default: false]
  "has_added_payment_method" boolean [not null, default: false]
  "has_added_vendor" boolean [not null, default: false]
  "has_created_first_payment" boolean [not null, default: false]
  "updated_at" timestamptz
  Note: 'Business entities and their KYB information with onboarding flags'
}

Table "business_user_relation" {
  "user_id" uuid [not null, ref: > user_table.id]
  "bid" uuid [not null, ref: > business.bid]
  "role" user_role_enum
  "role_claim" user_role_enum
  "kyb_initiated" boolean [default: false]
  "kyc_needed" boolean [default: true]
  "added_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz

  indexes {
    (user_id, bid) [pk]
  }
  Note: 'Maps users to businesses with specific roles'
}

Table "subscription_status" {
  "bid" uuid [pk, ref: > business.bid, note: 'ON DELETE CASCADE']
  "subscription_type" subscription_type_enum [not null]
  "start_date" date
  "expiry_date" date
  Note: 'Tracks subscription status of businesses'
}

// =============================================================================
// PAYMENT SYSTEM TABLES
// =============================================================================

Table "stored_cards" {
  "card_id" uuid [pk, default: `uuidv7()`]
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "token" text [not null, note: 'Gateway token - NOT actual card number']
  "last_four_digits" varchar(4) [not null]
  "card_type" card_type_enum [not null]
  "card_category" card_category_enum [not null]
  "expiry_month" varchar(2) [not null]
  "expiry_year" varchar(4) [not null]
  "issuer_bank" text
  "card_holder_name" text
  "is_active" boolean [default: true]
  "gateway_used" gateway_type_enum [not null]
  "added_at" timestamptz [default: `NOW()`]
  "last_used_at" timestamptz
  "metadata" jsonb

  indexes {
    (business_id, token) [unique, name: 'idx_stored_cards_token_unique']
  }
  Note: 'Tokenized card storage for recurring payments (PCI DSS compliant)'
}

Table "bank_accounts" {
  "account_id" uuid [pk, default: `uuidv7()`]
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "account_number_hash" varchar(64) [not null, note: 'SHA-256 hash for duplicate detection']
  "account_number_encrypted" text [not null, note: 'AES-256-GCM encrypted']
  "ifsc_code" varchar(11) [not null]
  "account_holder_name" text [not null]
  "bank_name" text
  "branch_name" text
  "account_type" varchar(20)
  "is_verified" boolean [default: false]
  "is_active" boolean [default: true]
  "added_at" timestamptz [default: `NOW()`]
  "metadata" jsonb [note: 'Penny drop verification details']

  indexes {
    (business_id, account_number_hash) [unique, name: 'idx_bank_accounts_unique']
  }
  Note: 'Bank accounts with encrypted account numbers for payment sources'
}

Table "payments" {
  "payment_id" uuid [pk, default: `uuidv7()`]
  "user_id" uuid [ref: > user_table.id, note: 'ON DELETE SET NULL']
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "amount" bigint [not null, note: 'Amount in paise (INR smallest unit)']
  "currency" currency_code_enum [not null, default: 'INR']
  "payment_method" payment_method_enum [not null]
  "status" payment_status_enum [not null, default: 'pending']
  "description" text
  "gateway_used" gateway_type_enum
  "gateway_payment_id" text [unique, note: 'Gateway transaction ID for webhook lookup']
  "callback_url" text
  "redirect_url" text
  "payment_source_id" uuid [note: 'Polymorphic ref to stored_cards or bank_accounts']
  "payment_source_type" payment_source_type_enum
  "fee_amount" bigint [default: 0]
  "total_amount" bigint [not null, note: 'amount + fee_amount (GST inclusive)']
  "metadata" jsonb [note: 'Gateway responses, payment attempts, failure reasons']
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "settlement_status" settlement_status_enum [default: 'pending']
  "settled_at" timestamptz
  "settlement_reference_id" varchar(255)
  "settlement_utr" varchar(100)
  "settlement_metadata" jsonb
  "settlement_amount" bigint [note: 'Actual amount settled by gateway']
  "mdr_amount" bigint [default: 0, note: 'Merchant Discount Rate - gateway fees']
  "net_settlement_amount" bigint [note: 'Final amount received after all deductions']
  "payment_type" payment_type [not null, default: 'payment']

  indexes {
    (gateway_payment_id) [unique, name: 'idx_payments_gateway_payment_id_unique', note: 'WHERE gateway_payment_id IS NOT NULL']
    (settlement_status, settled_at) [name: 'idx_payments_settlement']
    (business_id, settlement_status, settlement_amount, total_amount) [name: 'idx_payments_settlement_amounts']
    (gateway_used, settled_at, mdr_amount) [name: 'idx_payments_mdr_tracking']
    payment_type [name: 'idx_payments_payment_type']
  }
  Note: 'Main payment transaction records with gateway routing, fee tracking, and settlement'
}

Table "payment_fee_rules" {
  "rule_id" uuid [pk, default: `uuidv7()`]
  "payment_method" payment_method_enum [not null]
  "card_type" card_type_enum [note: 'NULL = applies to non-card payment methods']
  "card_category" card_category_enum [note: 'NULL = applies to non-card payment methods']
  "fee_type" fee_type_enum [not null]
  "percentage_fee" "decimal(5,2)" [note: 'e.g., 1.90 for 1.9%']
  "fixed_fee" bigint [default: 0, note: 'in paise (e.g., 2800 for ₹28)']
  "gst_percentage" "decimal(5,2)" [default: 18.00]
  "gst_applicable" boolean [default: true]
  "is_active" boolean [default: true]
  "created_at" timestamptz [not null, default: `NOW()`]
  "updated_at" timestamptz [default: `NOW()`]

  indexes {
    (payment_method, card_type, card_category) [name: 'idx_fee_rules_lookup', note: 'WHERE is_active = true']
  }
  Note: 'Simplified fee rules with explicit rules only - no NULL fallback complexity'
}

Table "payment_state_changes" {
  "state_change_id" uuid [pk, default: `uuidv7()`]
  "payment_id" uuid [not null, ref: > payments.payment_id, note: 'ON DELETE CASCADE']
  "transfer_request_id" uuid [ref: > payout_transfer_requests.transfer_request_id, note: 'ON DELETE SET NULL']
  "action" payment_action_enum [not null]
  "action_timestamp" timestamptz [not null, default: `NOW()`]
  "actor_type" payment_actor_enum [not null, default: 'system']
  "actor_user_id" uuid [ref: > user_table.id, note: 'ON DELETE SET NULL']
  "actor_name" varchar(100) [note: 'Denormalized: payout_worker, razorpay_webhook, etc.']
  "previous_state" varchar(50) [note: 'Previous status value if applicable']
  "new_state" varchar(50) [note: 'New status value if applicable']
  "amount" bigint [note: 'Amount involved in this action (in paise)']
  "currency" varchar(3) [default: 'INR']
  "utr" varchar(100) [note: 'Bank UTR for completed payouts']
  "provider" varchar(50) [note: 'Gateway/provider name (jiopay, easebuzz, castler)']
  "metadata" jsonb [note: 'Additional context (gateway response, error codes, etc.)']
  "remarks" text [note: 'Human-readable description']
  "created_at" timestamptz [not null, default: `NOW()`]

  indexes {
    (payment_id, action_timestamp) [name: 'idx_payment_state_payment']
    (transfer_request_id, action_timestamp) [name: 'idx_payment_state_transfer']
    (action, action_timestamp) [name: 'idx_payment_state_action']
    actor_user_id [name: 'idx_payment_state_actor', note: 'WHERE actor_user_id IS NOT NULL']
    action_timestamp [name: 'idx_payment_state_timestamp']
  }
  Note: 'Audit trail for payment and payout state transitions. Tracks payment lifecycle from initiation to payout completion.'
}

// =============================================================================
// PAYEE SYSTEM TABLES (Polymorphic Design)
// =============================================================================

Table "payee_master" {
  "payee_id" uuid [pk, default: `uuidv7()`]
  "payee_type" payee_type_enum [not null, note: 'Polymorphic discriminator']
  "is_active" boolean [default: true]
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  Note: 'Master routing table for all payee types (vendor, GST, biller, employee) - Minimal routing table only'
}

Table "payee_vendor" {
  "payee_id" uuid [pk, ref: - payee_master.payee_id, note: 'ON DELETE CASCADE']
  "gstin" varchar(15) [unique, not null]
  "legal_name" varchar(500) [not null]
  "business_type" varchar(100)
  "registration_date" date
  "gst_status" varchar(50) [not null]
  "building_name" varchar(255)
  "street" varchar(255)
  "city" varchar(100)
  "state" varchar(100)
  "pincode" varchar(10)
  "gst_verification_status" verification_status_enum [default: 'pending']
  "gst_verified_at" timestamptz
  "gst_data" jsonb [note: 'Full GST API response including directors']
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb
  Note: 'Vendor payees identified by GSTIN (businesses we pay)'
}

Table "payee_gst" {
  "payee_id" uuid [pk, ref: - payee_master.payee_id, note: 'ON DELETE CASCADE']
  "government_entity_name" varchar(255) [not null, default: 'Government of India - GST']
  "gst_portal_url" varchar(500) [default: 'https://www.gst.gov.in']
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb
  Note: 'Government GST payment entity (singleton - only one row)'
}

Table "payee_gst_virtual_accounts" {
  "virtual_account_id" uuid [pk, default: `uuidv7()`]
  "payee_id" uuid [not null, ref: > payee_master.payee_id, note: 'ON DELETE CASCADE']
  "virtual_account_number" varchar(50) [unique, not null]
  "ifsc_code" varchar(11) [not null]
  "bank_name" varchar(255) [default: 'Government GST Collection Account']
  "tax_period" varchar(20) [not null, note: 'e.g., Jan-2024, Q1-2024']
  "financial_year" varchar(10) [not null]
  "tax_type" varchar(50)
  "valid_from" timestamptz [not null]
  "valid_until" timestamptz [not null]
  "is_active" boolean [default: true]
  "challan_document_url" text [note: 'S3 URL of tax challan']
  "uploaded_at" timestamptz
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb
  Note: 'Virtual bank accounts for GST payments (generated monthly/quarterly)'
}

Table "payee_biller" {
  "payee_id" uuid [pk, ref: - payee_master.payee_id, note: 'ON DELETE CASCADE']
  "biller_id" varchar(100) [unique, not null]
  "biller_name" varchar(500) [not null]
  "biller_category" varchar(100) [not null, note: 'Electricity, Telecom, Water, Gas, etc.']
  "biller_description" text
  "bbps_biller_code" varchar(50)
  "npci_registered" boolean [default: true]
  "supports_adhoc" boolean [default: true]
  "supports_recurring" boolean [default: false]
  "payment_modes" "text[]"
  "avg_processing_time_hours" int
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb
  Note: 'BBPS system billers (electricity, telecom, water, etc.)'
}

Table "payee_biller_accounts" {
  "biller_account_id" uuid [pk, default: `uuidv7()`]
  "payee_id" uuid [not null, ref: > payee_master.payee_id, note: 'ON DELETE CASCADE']
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "mobile_number" varchar(20) [not null]
  "customer_params" jsonb [not null, note: 'Biller-specific parameters']
  "auto_fetch_enabled" boolean [default: false]
  "fetch_schedule" varchar(50)
  "preferred_fetch_day" int
  "last_bill_fetched_at" timestamptz
  "last_bill_amount" bigint
  "last_bill_due_date" date
  "is_active" boolean [default: true]
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb

  indexes {
    (business_id, payee_id, mobile_number) [unique, name: 'unique_business_biller']
  }
  Note: 'Customer-biller configurations (pseudo-account for BBPS payments)'
}

Table "payee_employee" {
  "payee_id" uuid [pk, ref: - payee_master.payee_id, note: 'ON DELETE CASCADE']
  "employee_code" varchar(100)
  "full_name" varchar(500) [not null]
  "email" varchar(254)
  "phone" varchar(20)
  "designation" varchar(200)
  "department" varchar(200)
  "date_of_joining" date
  "employment_type" varchar(50)
  "remuneration_doc_url" text [note: 'S3 URL (versioned at S3 level)']
  "remuneration_doc_uploaded_at" timestamptz
  "remuneration_doc_verified" boolean [not null, default: false, note: 'Document uploaded and verified']
  "is_sensitive" boolean [default: true, note: 'Always true for employees']
  "created_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb
  Note: 'Employee payees for payroll (individuals, not businesses)'
}

Table "payee_bank_accounts" {
  "account_id" uuid [pk, default: `uuidv7()`]
  "payee_id" uuid [not null, ref: > payee_master.payee_id, note: 'ON DELETE CASCADE']
  "account_number_encrypted" text [not null, note: 'Encrypted (plaintext in Phase 5.3)']
  "account_number_hash" varchar(64) [not null, note: 'SHA-256 for duplicate detection']
  "ifsc_code" varchar(11) [not null]
  "bank_name" varchar(255)
  "branch_name" varchar(255)
  "account_type" bank_account_type_enum [not null]
  "account_holder_name" varchar(255) [not null]
  "is_verified" boolean [default: false]
  "verified_at" timestamptz
  "bank_verification_status" verification_status_enum [default: 'pending']
  "bank_verification_data" jsonb [note: 'Penny drop verification details']
  "cross_verification_status" verification_status_enum [default: 'pending']
  "is_active" boolean [default: true]
  "account_label" varchar(100)
  "castler_beneficiary_id" varchar(255) [note: 'Castler provider beneficiary ID for payouts']
  "added_at" timestamptz [default: `NOW()`]
  "updated_at" timestamptz
  "metadata" jsonb

  indexes {
    (payee_id, account_number_hash) [unique, name: 'unique_payee_account']
    castler_beneficiary_id [name: 'idx_bank_accounts_castler_onboarded', note: 'WHERE castler_beneficiary_id IS NOT NULL']
  }
  Note: 'Bank accounts for vendor and employee payees (NOT for GST/Biller)'
}

Table "business_payee_relation" {
  "relation_id" uuid [pk, note: 'Surrogate key for simplified frontend API']
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "payee_id" uuid [not null, ref: > payee_master.payee_id, note: 'ON DELETE CASCADE']
  "account_id" uuid [not null, note: 'Polymorphic: bank/virtual/biller account']
  "display_name" varchar(255) [not null, note: 'Customer-specific name']
  "contact_email" varchar(254)
  "contact_phone" varchar(20)
  "notes" text
  "is_active" boolean [default: true]
  "is_favorite" boolean [default: false]
  "tags" "text[]"
  "type_specific_data" jsonb [note: 'Type-specific metadata']
  "added_at" timestamptz [default: `NOW()`]
  "added_by" uuid [not null, ref: > user_table.id, note: 'User who added this payee relation (required)']
  "last_used_at" timestamptz [note: 'Updated by payment system']
  "updated_at" timestamptz
  "metadata" jsonb

  indexes {
    (business_id, payee_id, account_id) [unique, name: 'business_payee_relation_business_payee_account_key']
    business_id [name: 'idx_business_payee_relation_business_id']
    payee_id [name: 'idx_business_payee_relation_payee_id']
  }
  Note: 'Customer-payee relationships (polymorphic - all payee types)'
}

// =============================================================================
// VOUCHER SYSTEM TABLES
// =============================================================================

Table "payment_vouchers" {
  "voucher_id" uuid [pk, default: `uuidv7()`]
  "voucher_number" varchar(50) [unique, not null, note: 'Format: PV-2024-00001']
  "voucher_date" date [not null, default: `CURRENT_DATE`]
  "fiscal_year" varchar(10) [not null, note: 'FY2024-25']
  "accounting_period" varchar(7) [not null, note: '2024-04 (Apr 2024)']
  "voucher_type" varchar(50) [not null, default: 'payment']
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "payee_id" uuid [not null]
  "account_id" uuid [not null]
  "invoice_number" varchar(100)
  "invoice_date" date
  "invoice_due_date" date
  "gross_amount" bigint [not null, note: 'Amount in paise']
  "net_amount" bigint [not null, note: 'Amount after TDS/discounts']
  "currency" varchar(3) [not null, default: 'INR']
  "gst_amount" bigint [default: 0]
  "gst_rate" "decimal(5,2)"
  "cgst_amount" bigint [default: 0]
  "sgst_amount" bigint [default: 0]
  "igst_amount" bigint [default: 0]
  "tds_amount" bigint [default: 0]
  "tds_rate" "decimal(5,2)"
  "tds_section" varchar(20) [note: 'e.g., 194C, 194J']
  "fee_amount" bigint [default: 0]
  "discount_amount" bigint [default: 0]
  "financial_details" jsonb [note: 'Line items, HSN codes, tax breakdowns']
  "attachments" jsonb [note: 'Invoice PDF, supporting docs']
  "expense_category" varchar(100)
  "description" text
  "status" varchar(50) [not null, default: 'draft', note: 'draft→finalized→posted→synced']
  "payment_id" uuid [ref: > payments.payment_id, note: 'ON DELETE RESTRICT, NULL when draft']
  "erp_sync_status" varchar(50) [not null, default: 'not_synced']
  "erp_reference_id" varchar(255) [note: 'ERP system voucher ID']
  "erp_posting_date" date
  "erp_last_sync_at" timestamptz
  "erp_sync_attempts" int [default: 0]
  "gl_expense_account" varchar(50)
  "gl_bank_account" varchar(50)
  "cost_center" varchar(50)
  "erp_metadata" jsonb [note: 'Vendor-specific ERP fields']
  "payout_status" varchar(50) [default: 'pending', note: 'pending→initiated→completed→failed']
  "payout_initiated_at" timestamp
  "payout_initiated_by" uuid [ref: > user_table.id, note: 'Operations user']
  "payout_completed_at" timestamp
  "payout_reference_id" varchar(255) [note: 'Payout gateway txn ID']
  "payout_utr" varchar(100) [note: 'Bank UTR for reconciliation']
  "payout_metadata" jsonb
  "cancellation_status" cancellation_status_enum [default: 'not_cancelled']
  "cancellation_requested_at" timestamptz
  "cancellation_requested_by" uuid [ref: > user_table.id]
  "cancellation_reason" text
  "cancellation_approved_at" timestamptz
  "cancellation_approved_by" uuid [ref: > user_table.id]
  "refund_status" refund_status_enum [default: 'not_applicable']
  "refund_initiated_at" timestamptz
  "refund_reference_id" varchar(255)
  "refund_metadata" jsonb
  "payment_terms" varchar(50) [note: 'e.g., Net 30, Net 45, Due on Receipt, 2/10 Net 30']
  "vendor_reference_number" varchar(100) [note: 'Vendor reference or PO number from invoice']
  "created_at" timestamptz [not null, default: `NOW()`]
  "created_by_user_id" uuid [ref: > user_table.id, note: 'ON DELETE SET NULL']
  "updated_at" timestamptz
  "metadata" jsonb

  indexes {
    (payout_status, payee_id) [name: 'idx_vouchers_payout_pending']
    (payee_id, payout_completed_at) [name: 'idx_vouchers_payout_history']
    (cancellation_status, cancellation_requested_at) [name: 'idx_vouchers_cancellation']
  }
  Note: 'Payment vouchers for accounting and ERP integration (draft-first approach)'
}

// Composite FK constraint for payment_vouchers
Ref: payment_vouchers.(business_id, payee_id, account_id) > business_payee_relation.(business_id, payee_id, account_id)

Table "voucher_approvals" {
  "approval_id" uuid [pk, default: `uuidv7()`]
  "voucher_id" uuid [not null, ref: > payment_vouchers.voucher_id, note: 'ON DELETE CASCADE']
  "requester_user_id" uuid [not null, ref: > user_table.id, note: 'User who initiated the payment']
  "approver_user_id" uuid [not null, ref: > user_table.id, note: 'User who approved/rejected the payment']
  "action" approval_action_enum [not null, default: 'pending', note: 'pending → approved/rejected/request_changes/edited']
  "remarks" text [note: 'Approver notes explaining their decision']
  "created_at" timestamptz [not null, default: `NOW()`]

  indexes {
    voucher_id [name: 'idx_voucher_approvals_voucher']
    (approver_user_id, action) [name: 'idx_voucher_approvals_approver']
    requester_user_id [name: 'idx_voucher_approvals_requester']
  }
  Note: 'Approval workflow audit log. Each row represents an approval action/event. Query latest status with ORDER BY created_at DESC.'
}

Table "erp_sync_queue" {
  "queue_id" uuid [pk, default: `uuidv7()`]
  "voucher_id" uuid [not null, ref: > payment_vouchers.voucher_id, note: 'ON DELETE CASCADE']
  "sync_direction" varchar(20) [not null, note: 'push, pull']
  "queue_status" varchar(50) [not null, default: 'pending', note: 'pending→processing→completed→failed']
  "retry_count" int [default: 0]
  "max_retries" int [default: 3]
  "next_retry_at" timestamptz
  "request_payload" jsonb
  "response_payload" jsonb
  "error_code" varchar(100)
  "error_message" text
  "created_at" timestamptz [not null, default: `NOW()`]
  "started_at" timestamptz
  "completed_at" timestamptz
  Note: 'Async queue for ERP synchronization workers'
}

// =============================================================================
// BATCH PAYMENT TABLES
// =============================================================================

Table "batch_payments" {
  "batch_id" uuid [pk, default: `uuidv7()`]
  "business_id" uuid [not null, ref: > business.bid, note: 'ON DELETE CASCADE']
  "uploaded_by" uuid [not null, ref: > user_table.id, note: 'ON DELETE RESTRICT']
  "file_name" varchar(255) [note: 'Optional: for audit trail']
  "status" varchar(20) [not null, note: 'pending, processing, completed, failed, cancelled']
  "total_rows" int [not null, default: 0]
  "total_amount" bigint [not null, default: 0, note: 'Total CSV amount in paise (informational only)']
  "processed_rows" int [not null, default: 0]
  "success_rows" int [not null, default: 0]
  "failed_rows" int [not null, default: 0]
  "created_at" timestamptz [not null, default: `NOW()`]
  "processed_at" timestamptz
  "completed_at" timestamptz

  indexes {
    business_id [name: 'idx_batch_payments_business_id']
    status [name: 'idx_batch_payments_status']
    created_at [name: 'idx_batch_payments_created_at']
  }
  Note: 'Batch payment CSV upload tracking'
}

Table "batch_payment_items" {
  "item_id" uuid [pk, default: `uuidv7()`]
  "batch_id" uuid [not null, ref: > batch_payments.batch_id, note: 'ON DELETE CASCADE']
  "row_number" int [not null]
  "status" varchar(20) [not null, note: 'matched, ambiguous, not_found, pending, processing, success, failed, skipped']
  "csv_payee_name" varchar(255) [not null]
  "csv_account_last_4" varchar(4)
  "csv_amount" bigint [not null, note: 'In paise']
  "payment_context" varchar(50) [not null]
  "description" text
  "expense_category" varchar(100)
  "gst_amount" bigint [default: 0]
  "tds_amount" bigint [default: 0]
  "invoice_number" varchar(100)
  "matched_relation_id" uuid [note: 'FK to business_payee_relation']
  "match_confidence" "decimal(3,2)" [note: '0.00 to 1.00']
  "voucher_id" uuid [note: 'FK to vouchers (created draft voucher)']
  "error_message" text
  "created_at" timestamptz [not null, default: `NOW()`]
  "processed_at" timestamptz

  indexes {
    (batch_id, row_number) [unique]
    batch_id [name: 'idx_batch_payment_items_batch_id']
    status [name: 'idx_batch_payment_items_status']
    voucher_id [name: 'idx_batch_payment_items_voucher_id']
  }
  Note: 'Individual batch payment items with matching and processing status'
}

// =============================================================================
// PAYOUT SYSTEM TABLES
// =============================================================================

Table "payout_transfer_requests" {
  "transfer_request_id" uuid [pk, default: `uuidv7()`]
  "voucher_id" uuid [not null, unique, ref: > payment_vouchers.voucher_id, note: 'ON DELETE RESTRICT']
  "provider" varchar(50) [not null]
  "provider_beneficiary_id" varchar(255) [not null]
  "provider_transfer_id" varchar(255) [note: 'Castler transfer ID (set after initiation)']
  "amount" bigint [not null]
  "currency" varchar(3) [not null, default: 'INR']
  "purpose" varchar(255)
  "reference" varchar(255)
  "narration" text
  "transfer_mode" varchar(50) [note: 'NEFT, RTGS, IMPS']
  "requires_approval" boolean [not null, default: false]
  "approval_mode" varchar(20) [note: 'auto, manual']
  "approved_by" uuid [ref: > user_table.id]
  "approved_at" timestamptz
  "status" payout_transfer_status_enum [not null, default: 'approved']
  "initiated_at" timestamptz
  "processing_at" timestamptz
  "completed_at" timestamptz
  "failed_at" timestamptz
  "failure_reason" text
  "utr" varchar(100) [note: 'Bank UTR from webhook']
  "retry_count" int [not null, default: 0]
  "max_retries" int [not null, default: 3]
  "next_retry_at" timestamptz
  "last_retry_at" timestamptz
  "last_webhook_at" timestamptz
  "webhook_timeout_at" timestamptz [note: 'Flag if no webhook received']
  "webhook_history" "jsonb[]" [note: 'Array of all webhook payloads']
  "provider_metadata" jsonb
  "created_at" timestamptz [not null, default: `NOW()`]
  "updated_at" timestamptz [default: `NOW()`]

  indexes {
    voucher_id [name: 'idx_payout_transfers_voucher']
    status [name: 'idx_payout_transfers_status']
    provider_transfer_id [name: 'idx_payout_transfers_provider_transfer_id']
    (status, amount) [name: 'idx_payout_pending_approval']
    (status, created_at) [name: 'idx_payout_approved']
    (status, initiated_at) [name: 'idx_payout_initiated']
    webhook_timeout_at [name: 'idx_payout_timeout']
    (next_retry_at, retry_count) [name: 'idx_payout_retry']
  }
  Note: 'Audit trail for all payout transfer attempts with webhook-driven status updates'
}

Table "payout_configuration" {
  "config_id" uuid [pk, default: `uuidv7()`]
  "business_id" uuid [unique, ref: > business.bid, note: 'NULL = global default, specific UUID = per-business']
  "auto_approval_enabled" boolean [not null, default: true]
  "auto_approval_limit" bigint [not null, default: 20000000, note: '₹2,00,000 in paise']
  "preferred_transfer_mode" varchar(50) [not null, default: 'NEFT']
  "max_retry_attempts" int [not null, default: 3]
  "retry_delay_minutes" int [not null, default: 15]
  "retry_backoff_multiplier" "decimal(3,1)" [not null, default: 2.0]
  "webhook_timeout_minutes" int [not null, default: 60]
  "batch_size" int [not null, default: 100]
  "worker_enabled" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `NOW()`]
  "updated_at" timestamptz [default: `NOW()`]

  indexes {
    business_id [name: 'idx_payout_config_business']
  }
  Note: 'Payout system configuration including auto-approval limits and retry settings'
}

// =============================================================================
// NOTIFICATION SYSTEM TABLES
// =============================================================================

Table "notification_events" {
  "id" bigserial [pk]
  "event_type" text [not null, note: 'e.g., payment.failed, report.ready']
  "payload" jsonb [not null, note: 'Full message data (target, entities, message, actions)']
  "created_at" timestamptz [not null, default: `NOW()`]

  Note: 'Temporary queue of notification events to be fanned out and deleted'
}

Table "user_notifications" {
  "id" bigserial [pk]
  "user_id" uuid [not null, ref: > user_table.id, note: 'ON DELETE CASCADE']
  "business_id" uuid [ref: > business.bid, note: 'ON DELETE CASCADE']
  "event_id" bigint [not null, note: 'No FK, just for unique constraint (events are deleted)']
  "channel" text [not null, note: 'email, push, web']
  "status" text [not null, default: 'pending', note: 'pending, processing, sent, failed, read']
  "content" jsonb [not null, note: '{title, body, actions, entities}']
  "retry_count" int [not null, default: 0, note: 'Number of retry attempts for failed jobs']
  "created_at" timestamptz [not null, default: `NOW()`]
  "sent_at" timestamptz
  "read_at" timestamptz

  indexes {
    (user_id, read_at, created_at) [name: 'idx_user_notifications_user_web', note: 'WHERE channel = web, read_at NULLS FIRST, created_at DESC']
    (channel, status, retry_count, created_at) [name: 'idx_user_notifications_worker_jobs', note: 'WHERE status IN (pending, failed)']
    created_at [name: 'idx_user_notifications_stuck_processing', note: 'WHERE status = processing']
    (event_id, user_id, channel) [unique, name: 'uq_user_notifications_event']
  }
  Note: 'Persistent notification inbox for each user. Email/push notifications deleted after successful send. Web channel persists for bell icon.'
}

Table "notification_preferences" {
  "user_id" uuid [pk, ref: > user_table.id, note: 'ON DELETE CASCADE']
  "email_enabled" boolean [not null, default: true, note: 'Global switch for email notifications']
  "push_enabled" boolean [not null, default: true, note: 'Global switch for push notifications']
  "messages_enabled" boolean [not null, default: true, note: 'Global switch for in-app messages/web notifications']
  "category_preferences" jsonb [not null, default: '{"announcements": true, "rewards": true, "payments": true, "payees": true, "approvals": true, "security": true, "insights": true}', note: 'Category-level preferences']
  "created_at" timestamptz [not null, default: `NOW()`]
  "updated_at" timestamptz

  Note: 'User notification preferences (global, not per-business)'
}
